# FleetSentinel web console — copy to .env and adjust.
# Unset VITE_API_BASE_URL = mock mode (default dev). Set it to hit the real API.
VITE_API_BASE_URL=
# Keycloak realm base URL for OIDC + PKCE, e.g. http://localhost:8080/realms/fleetsentinel
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=fleetsentinel-web
